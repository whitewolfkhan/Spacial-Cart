# Copy to .env and fill in.

# PostgreSQL connection for the Prisma catalog (required).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/spatialcart?schema=public"

# --- Cloudflare R2 (3D asset storage) -------------------------------------
# When ALL four R2_* vars are set, /api/models returns time-limited pre-signed
# GET URLs so the bucket can stay private. If they're unset, the app falls back
# to serving the .glb files from /public/models by key (no credentials needed).
#
# Create an R2 API token (Object Read) in the Cloudflare dashboard. The account
# ID is in the R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: how long signed URLs stay valid, in seconds (default 3600 = 1h).
# R2_SIGNED_URL_TTL=3600

# --- Merchant admin auth (/admin) -----------------------------------------
# ADMIN_PASSWORD: the password merchants type at /admin/login.
# ADMIN_SECRET:   server-side key used to HMAC-sign the admin_token cookie.
#                 Use a long random string; rotating it logs everyone out.
ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-with-a-long-random-string

# Optional: enable real Stripe Checkout (test mode). Without it, /api/checkout
# uses a built-in mock success flow.
# STRIPE_SECRET_KEY=sk_test_your_key_here
